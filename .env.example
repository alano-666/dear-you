# 环境变量模板:复制为 .env 并填入真实密钥(.env 已被 gitignore,不会提交)
# Vercel 部署时在项目后台 Settings → Environment Variables 中配置同名变量

# ===== 智谱 GLM —— 视觉识别(glm-4v-flash,免费) =====
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ===== 百智云 —— 信件生成(Anthropic 兼容网关,第三方中转,仅 demo 使用) =====
BAIZHI_API_KEY=
BAIZHI_BASE_URL=https://ai-api-gateway.app.baizhi.cloud/api/anthropic

# ===== 模型(可切换:换模型只改这里) =====
VISION_MODEL=glm-4v-flash
TEXT_MODEL=glm-5.3-flash
